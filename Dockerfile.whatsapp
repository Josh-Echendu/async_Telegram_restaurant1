FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \

    # ✅ Tells Python to look in /app
    PYTHONPATH=/app  

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Install dependencies
COPY WHATSAPP_BOT_API/requirements.txt .
RUN uv pip install --system --no-cache -r requirements.txt

# Copy shared package
COPY COMMON /app/COMMON

# ✅ Copy the WhatsApp code into its own folder
COPY WHATSAPP_BOT_API/ /app/WHATSAPP_BOT_API/

# ✅ Make the entrypoint script executable
RUN chmod +x /app/WHATSAPP_BOT_API/entrypoint_whatsapp.sh

EXPOSE 8080

# ✅ Run the script
CMD ["/app/WHATSAPP_BOT_API/entrypoint_whatsapp.sh"]